            "description": "Tuỳ chọn. Để trống thì dùng \"[Mã vị trí] Ứng tuyển Tên vị trí\"."
          },
          "custom": {
            "selector": ".jd-side"
          }
        },
        {
          "name": "skills",
          "type": "array",
          "label": "Kỹ năng chính (nhãn)",
          "labels": {
            "singular": "Nhãn",
            "plural": "Nhãn"
          },
          "admin": {
            "description": "Tuỳ chọn. Để trống thì dùng phần Yêu cầu."
          },
          "fields": [
            {
              "name": "text",
              "type": "text",
              "required": true,
              "label": "Nội dung"
            }
          ]
        },
        {
          "name": "areas",
